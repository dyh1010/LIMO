<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>limo_cleanup_bringup</name>
  <version>0.0.0</version>
  <description>Launch files for the LIMO cleanup robot system.</description>
  <maintainer email="dyh@todo.todo">dyh</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>launch</depend>
  <depend>launch_ros</depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <depend>limo_cleanup_core</depend>
  <depend>limo_cleanup_language</depend>
  <depend>limo_cleanup_executor</depend>
  <depend>limo_cleanup_base</depend>
  <depend>limo_cleanup_perception</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
