{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:limo-cleanup:voice:asr-model-intake-readiness:v1",
  "title": "LIMO offline ASR model intake readiness report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "mode",
    "status",
    "delivery_ready",
    "input",
    "model",
    "grammar_probe",
    "validator",
    "blocking_issues"
  ],
  "properties": {
    "schema_id": {
      "const": "urn:limo-cleanup:voice:asr-model-intake-readiness:v1"
    },
    "schema_version": {"const": 1},
    "mode": {
      "const": "offline_local_vosk_model_intake_no_network_no_ros"
    },
    "status": {"enum": ["PASS", "BLOCKED"]},
    "delivery_ready": {"type": "boolean"},
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provided_model_path",
        "path_policy",
        "automatic_search_performed",
        "network_access_performed",
        "download_performed",
        "install_performed"
      ],
      "properties": {
        "provided_model_path": {"type": "string"},
        "path_policy": {
          "const": "explicit_absolute_local_directory_only"
        },
        "automatic_search_performed": {"const": false},
        "network_access_performed": {"const": false},
        "download_performed": {"const": false},
        "install_performed": {"const": false}
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "inventory", "validation"],
      "properties": {
        "path": {"type": ["string", "null"]},
        "inventory": {"$ref": "#/$defs/inventory"},
        "validation": {"type": "object"}
      }
    },
    "grammar_probe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sample_rate_hz",
        "phrase_count",
        "phrases_sha256",
        "attempted",
        "passed"
      ],
      "properties": {
        "sample_rate_hz": {"const": 16000},
        "phrase_count": {"type": "integer", "minimum": 1},
        "phrases_sha256": {"$ref": "#/$defs/sha256"},
        "attempted": {"type": "boolean"},
        "passed": {"type": "boolean"}
      }
    },
    "validator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifacts"],
      "properties": {
        "artifacts": {
          "type": "array",
          "items": {"$ref": "#/$defs/artifact"}
        }
      }
    },
    "blocking_issues": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "bytes", "sha256"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "bytes": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "directory_sha256",
        "file_count",
        "total_bytes",
        "files"
      ],
      "properties": {
        "algorithm": {"const": "sha256-tree-json-lines-v1"},
        "directory_sha256": {
          "anyOf": [
            {"$ref": "#/$defs/sha256"},
            {"type": "null"}
          ]
        },
        "file_count": {"type": "integer", "minimum": 0},
        "total_bytes": {"type": "integer", "minimum": 0},
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "bytes", "sha256"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "bytes": {"type": "integer", "minimum": 0},
              "sha256": {"$ref": "#/$defs/sha256"}
            }
          }
        }
      }
    }
  }
}
