<?xml version="1.0"?>
<launch>
  <!-- Formal perception only: the caller must bind the immutable task and
       capture identities used by the stopped rosbag1 and typed-frame set. -->
  <arg name="rgb_topic" default="/camera/color/image_raw"/>
  <arg name="depth_topic" default="/camera/depth/image_raw"/>
  <arg name="rgb_camera_info_topic" default="/camera/color/camera_info"/>
  <arg name="depth_camera_info_topic" default="/camera/depth/camera_info"/>
  <arg name="model_manifest" default="$(find limo_cleanup_ros1_perception)/config/model_bindings.json"/>
  <arg name="task_id"/>
  <arg name="capture_id"/>

  <node pkg="limo_cleanup_ros1_perception"
        type="dual_model_detector.py"
        name="cleanup_dual_model_detector"
        output="screen"
        required="true">
    <param name="rgb_topic" value="$(arg rgb_topic)"/>
    <param name="depth_topic" value="$(arg depth_topic)"/>
    <param name="rgb_camera_info_topic" value="$(arg rgb_camera_info_topic)"/>
    <param name="depth_camera_info_topic" value="$(arg depth_camera_info_topic)"/>
    <param name="model_manifest" value="$(arg model_manifest)"/>
    <param name="formal_capture_mode" value="true"/>
    <param name="task_id" value="$(arg task_id)"/>
    <param name="capture_id" value="$(arg capture_id)"/>
    <param name="confidence" value="0.35"/>
    <param name="iou" value="0.45"/>
    <param name="image_size" value="640"/>
    <param name="max_sync_delta_sec" value="0.15"/>
    <param name="depth_scale" value="0.001"/>
    <param name="opening_height_ratio" value="0.62"/>
    <param name="in_bin_overlap" value="0.30"/>
  </node>
</launch>
